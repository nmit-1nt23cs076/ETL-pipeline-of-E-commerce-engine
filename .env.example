# xAI API Key for Grok LLM (from https://console.x.ai/)
XAI_API_KEY=your_xai_api_key_here

# SerpAPI Key for Google Shopping Scraper (from https://serpapi.com/) - Optional, built-in mock fallback available
SERPAPI_API_KEY=your_serpapi_key_here

# Model Selection (Defaults to grok-4)
GROK_MODEL=grok-4

# ETL Settings
USE_MOCK_DATA=True
SQLITE_DB_PATH=data/ecommerce.db
VECTOR_STORE_DIR=vectorstore
